rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the authenticated user is the designated admin
    function isAdmin() {
      return request.auth == null || (
        request.auth.token.email == 'alexticona060@gmail.com' ||
        request.auth.token.email == 'alexticona060@gmai.com'
      );
    }

    // User profiles & roles: Allow app sync
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products catalog: Allow full sync
    match /products/{productId} {
      allow read, write: if true;
    }

    // Sales & invoices
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Employees and staff management
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Expenses & financial records
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Business settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Purchase orders (pedidos)
    match /purchase_orders/{orderId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
